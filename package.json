{
  "name": "patrimonio",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"yarn web:dev\" \"yarn sanity:dev\"",
    "build": "concurrently \"yarn web:build\" \"yarn sanity:build\"",
    "start": "concurrently \"yarn web:start\" \"yarn sanity:start\"",
    "web:dev": "yarn workspace patrimonio-nuxt dev",
    "web:build": "yarn workspace patrimonio-nuxt build",
    "web:start": "yarn workspace patrimonio-nuxt start",
    "sanity:dev": "yarn workspace studio dev",
    "sanity:build": "yarn workspace studio build",
    "sanity:start": "yarn workspace studio start"
  },
  "packageManager": "yarn@4.9.1",
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": "20.x"
  }
}
